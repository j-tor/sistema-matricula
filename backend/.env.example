# =============================================
# BACKEND - Variables de entorno
# =============================================
# Copia este archivo como .env y ajusta los valores.
# Con Docker Compose no hace falta: las variables se definen en docker-compose.yml.

NODE_ENV=development
PORT=3005
FRONTEND_URL=http://localhost:5174

# Zona horaria para calcular el año lectivo actual (fecha del servidor)
ZONA_HORARIA=America/Tegucigalpa

# --- Base de datos PostgreSQL (Prisma) ---
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
# Desde tu máquina el contenedor de PostgreSQL se expone en el puerto 5434.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/sistema_matricula

# --- Usuarios iniciales del seed (pnpm db:seed / pnpm docker:seed) ---
# Completa estos valores en tu .env; no subas contraseñas reales al repositorio.
SEED_USER_1_NAME=
SEED_USER_1_USERNAME=
SEED_USER_1_PASSWORD=
SEED_USER_2_NAME=
SEED_USER_2_USERNAME=
SEED_USER_2_PASSWORD=
